# Copy this file to .env.local and fill in the values from your Supabase project:
# Supabase dashboard > Project Settings > API (or "API Keys").

# Public values (safe in the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # or the legacy "anon" key

# Where the app is served. Used in confirmation email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: the product name shown in the app
NEXT_PUBLIC_APP_NAME=School Learning

# Server-only secrets. NEVER prefix these with NEXT_PUBLIC_.
# Only needed for `npm run seed:video` (uploading the pilot video).
SUPABASE_SERVICE_ROLE_KEY=

# Paystack (not integrated yet; the webhook only checks signatures)
PAYSTACK_SECRET_KEY=
